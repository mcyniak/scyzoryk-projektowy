{
  "name": "scyzoryk-projektowy",
  "version": "1.0.0",
  "private": true,
  "description": "Panel startowy dla lokalnych narzedzi Node.js: drukarka, pieczatki PDF i formularze Ecodan.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start-only": "node server.js",
    "install-all": "node scripts/install-all.js",
    "check": "node scripts/check-project.js",
    "test:group1": "node --test test/group1-hardening.test.js test/group1-supervisor.test.js",
    "test:group2": "node --test test/group2-printing.test.js",
    "test:group3": "node --test test/group3-ocr.test.js",
    "test:group4": "node --test test/group4-ecodan.test.js",
    "test:group5": "node --test test/group5-dokumenty-seryjne.test.js",
    "test:group6": "node --test test/group6-workflows.test.js",
    "test:group7": "node --test test/group7-data-paths.test.js",
    "test:regressions": "node scripts/run-regression-tests.js",
    "security-smoke": "node scripts/security-smoke-test.js",
    "audit": "node scripts/check-project.js",
    "package": "node scripts/build-package.js",
    "build-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
