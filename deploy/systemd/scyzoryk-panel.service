[Unit]
Description=Scyzoryk Projektowy - panel glowny (pilot linuksowy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcyniak
WorkingDirectory=/home/mcyniak/scyzoryk-linux-pilot
Environment=SCYZORYK_PROFILE=linux-pilot
Environment=SCYZORYK_HOST=0.0.0.0
# Port 80, zeby panel byl dostepny pod adresem "http://scyzoryk" bez podawania
# numeru portu. Uprawnienie do zbindowania portu <1024 nadane WYLACZNIE tej
# usludze systemd (nie calemu /usr/bin/node globalnie - to byloby szersze niz
# potrzeba na wspoldzielonym urzadzeniu) - User ponizej zostaje zwyklym
# uzytkownikiem, bez roota.
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
# Restart=always i tak NIE przeszkadza "systemctl stop" (systemd wie, ze to
# swiadome zatrzymanie i nie odpala ponownie) - to jest wylacznie na
# wypadek awarii/padu procesu, zgodnie z "ma sie resetowac sam".
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
