[Unit]
Description=Montowanie Dysku Google (Scyzoryk) przez rclone
After=network-online.target
Wants=network-online.target
Before=scyzoryk-panel.service

[Service]
Type=simple
User=mcyniak
ExecStartPre=/bin/mkdir -p /mnt/scyzoryk-google-drive
ExecStart=/usr/bin/rclone mount scyzoryk-drive: /mnt/scyzoryk-google-drive --vfs-cache-mode writes --dir-cache-time 30s
ExecStop=/bin/fusermount -u /mnt/scyzoryk-google-drive
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
