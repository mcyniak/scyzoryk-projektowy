[Unit]
Description=Montowanie Dysku Google (Scyzoryk) przez rclone
After=network-online.target
Wants=network-online.target
Before=scyzoryk-panel.service

[Service]
Type=simple
User=mcyniak
# KOLEJNOSC PONIZEJ MA ZNACZENIE. Najpierw fusermount -uz, DOPIERO POTEM
# mkdir/chown - "-uz" (nie samo "-u") sprzata POPRZEDNIE, nie do konca
# odmontowane punkty montowania. Martwy/osierocony punkt montowania FUSE
# potrafi sprawiac, ze ZWYKLE "stat"/"mkdir -p"/"chown" na tej samej sciezce
# hangowalo albo konczylo sie bledem "Transport endpoint is not connected" -
# wiec mkdir/chown MUSZA isc PO posprzataniu starego mountu, nie przed.
# Wiodacy "-" przy fusermount ignoruje kod bledu - przy zwyklym starcie (nic
# jeszcze nie zamontowane) ta komenda ma PRAWO sie nie udac, to nie powod,
# zeby caly start uslugi mial nie ruszyc.
ExecStartPre=-/bin/fusermount -uz /mnt/scyzoryk-google-drive
# "/mnt" nalezy do roota (drwxr-xr-x root:root) na swiezym systemie - zwykly
# "mkdir -p" jako User=mcyniak ponizej nie ma prawa utworzyc tam podkatalogu,
# wiec caly start uslugi wisialby w petli Restart=always/RestartSec=5 na
# zawsze na nowej instalacji. Prefiks "+" przed ExecStartPre uruchamia
# WYLACZNIE te jedna komende jako root (niezaleznie od User= ponizej) - reszta
# uslugi (samo montowanie rclone) nadal dziala jako zwykly uzytkownik.
ExecStartPre=+/bin/mkdir -p /mnt/scyzoryk-google-drive
ExecStartPre=+/bin/chown mcyniak:mcyniak /mnt/scyzoryk-google-drive
# vfs-cache-mode=full (nie tylko "writes") - klasyfikacja zalacznikow czyta
# zawartosc kazdego pliku (mammoth/pdf-parse), a bez cache odczytu KAZDY
# odczyt idzie na zywo przez siec do Google - stad "bardzo dlugo szuka" przy
# pierwszym realnym tescie. Limit rozmiaru/wieku cache wazny na tej karcie
# microSD (29GB, malo miejsca) - stare/duze pliki same wypadaja z cache.
# --drive-export-formats xlsx - prawdziwe Arkusze Google (nie zwykle .xlsx
# wgrane na Dysk) nie sa "plikiem" w zwyklym sensie - bez tej opcji rclone
# w ogole by ich nie pokazal jako czegos do odczytania. Z ta opcja kazdy
# Arkusz Google widoczny jest w montowaniu jako wirtualny "Nazwa.xlsx",
# ktory przy odczycie rclone sam eksportuje z Google na biezaco - reszta
# kodu (read-excel-file/xlsx) czyta go dokladnie tak samo jak zwykly plik
# .xlsx, bez zadnych zmian.
ExecStart=/usr/bin/rclone mount scyzoryk-drive: /mnt/scyzoryk-google-drive --vfs-cache-mode full --vfs-cache-max-size 2G --vfs-cache-max-age 24h --dir-cache-time 30s --drive-export-formats xlsx
ExecStop=/bin/fusermount -u /mnt/scyzoryk-google-drive
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
