# Przyklad konfiguracji dla pilota linuksowego (Raspberry Pi). Skopiuj do
# .env i uzupelnij, albo przekaz te same zmienne przez EnvironmentFile=
# w jednostce systemd (patrz docs/linux-pilot-install.md, ETAP 6).
# Nie commituj pliku .env z prawdziwymi wartosciami - .gitignore juz go
# ignoruje.

# Profil steruje tym, ktore aplikacje sa w ogole widoczne/uruchamiane.
# Patrz config/profiles.json.
SCYZORYK_PROFILE=linux-pilot

# 0.0.0.0 = dostepne w calej sieci LAN. Dla testow lokalnych na jednej
# maszynie mozna zostawic 127.0.0.1.
SCYZORYK_HOST=0.0.0.0

# Port glownego panelu (lista narzedzi + panel administratora).
PORT=3000

# Gdzie trzymac pliki anonimowych sesji roboczych (pracownicy NIE maja
# kont, wiec nie ma tu bazy uzytkownikow ani hasel). Domyslnie: ./data/auth
# wewnatrz repo. Na Raspberry Pi warto wskazac katalog poza repo, np.
# /var/lib/scyzoryk - wtedy aktualizacja kodu (git pull) nie rusza danych.
# SCYZORYK_DATA_ROOT=/var/lib/scyzoryk

# Porty poszczegolnych aplikacji-dzieci (mozna zostawic domyslne, o ile
# zaden inny proces na Raspberry Pi ich nie zajmuje).
# PIECZATKI_PORT=3002
# DRUKARKA_PORT=3001
# FORMULARZE_PORT=3003
# KARTY_PORT=3006
# DRUKARKA_PROJEKTY_PORT=3010

# Dysk Google zamontowany przez rclone (ETAP 2) - punkt montowania i
# konkretny podkatalog z projektami. Karty katalogowe (i docelowo Drukarka
# projektow) czytaja/pisza WYLACZNIE wewnatrz SCYZORYK_PROJECTS_ROOT - to
# nie jest caly zamontowany dysk, tylko jeden jego podfolder. Bez tych
# zmiennych aplikacje dzialaja w trybie zapasowym (uzytkownik podaje pelna
# sciezke recznie, jak dotychczas na Windows) - ustaw je dopiero, gdy rclone
# faktycznie montuje prawdziwy Dysk Google na tym urzadzeniu.
# SCYZORYK_GOOGLE_DRIVE_ROOT=/mnt/scyzoryk-google-drive
# SCYZORYK_PROJECTS_ROOT=/mnt/scyzoryk-google-drive/Dzial Projektowy Sanitarny
