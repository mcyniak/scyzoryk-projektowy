.claude/settings.local.json
.serena/cache/
.serena/project.local.yml

# Logi i raporty diagnostyczne
*.log
*.jsonl
**/logs/
__suite*
__test_ds*
node-report-*.json

# Pliki wygenerowane i przeslane przez uzytkownikow
**/output/
**/uploads/
**/downloads/

# Historia wykonanych zadan
**/data/jobs.json
**/data/print-log.txt
**/data/ostatnie-foldery.json

# Testy zawierajace prawdziwe dokumenty
apps/drukarka-projekty/test/fixtures/

