# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Hasla, tokeny i konfiguracja lokalna
.env
.env.*
!.env.example

# Lokalne ustawienia Claude i Serena
.claude/settings.local.json
.claude/scheduled_tasks.lock
.serena/cache/
.serena/project.local.yml

# Logi i raporty diagnostyczne
*.log
*.jsonl
**/logs/
__suite*
__test_ds*
node-report-*.json

# Pliki wygenerowane i przeslane przez uzytkownikow
**/output/
**/uploads/
**/downloads/

# Historia wykonanych zadan
**/data/jobs.json
**/data/print-log.txt
**/data/ostatnie-foldery.json

# ocr-audytow: skany audytow (dane osobowe) + posrednie obrazy stron -
# nigdy nie commitowac, w odroznieniu od innych apek data/ tu trzyma
# realna tresc dokumentow, nie tylko historie zadan
apps/ocr-audytow/data/

# Testy zawierajace prawdziwe dokumenty
apps/drukarka-projekty/test/fixtures/

# Artefakty budowania launchera (.NET) - wynik lokalnego dotnet build/publish,
# nigdy nie powinny byc zacommitowane
launcher/**/bin/
launcher/**/obj/

# Pliki tymczasowe
~$*
*.bak
*.tmp

# System
Thumbs.db
desktop.ini
.DS_Store

# Artefakty narzedzia playwright-cli (snapshoty/logi z testowania UI)
.playwright-cli/

# Zbudowane paczki do rozeslania (scripts/build-package.js) - wynik, nie zrodlo
release/

# Generowany przez scripts/build-installer.ps1 do zainstalowanej kopii - w repo
# deweloperskim moze pojawic sie tylko recznie (np. do testowania updatera
# lokalnie), nigdy nie powinien byc zacommitowany.
/build-info.json

# graphify - wygenerowany cache grafu wiedzy (duzy, odtwarzalny komenda
# `graphify update .`) i kopia zapasowa ustawien sprzed instalacji skilla -
# zadne z nich nie jest zrodlem, nie powinny trafiac do historii repo.
graphify-out/
.claude/settings.json.graphify-bak

# Notatki sesyjne agentow/usera - wewnetrzne, nie dla publicznego repo.
/HANDOFF-NASTEPNA-SESJA.md

# Scratch-demo paska postepu launchera (zostaje lokalnie wg decyzji wlasciciela).
launcher/_Demo/

.hermes/
